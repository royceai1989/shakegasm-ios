default_platform(:ios)

# ShakeGasm iOS — build the bundled Capacitor app and ship it to TestFlight.
# Signing uses the App Store Connect API key ONLY (no Apple ID / 2FA / Spaceship):
# Xcode automatic signing resolves the cert + provisioning profile through the
# API key via `-allowProvisioningUpdates -authenticationKey*`.
platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci # ephemeral keychain on CI runners

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8"],
      is_key_content_base64: false
    )

    # Build number = next after TestFlight's latest (API-key auth).
    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.shakegasm.app",
      initial_build_number: 0
    ) + 1
    increment_build_number(build_number: next_build, xcodeproj: "ios/App/App.xcodeproj")

    # Switch the project to automatic signing under the team.
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: true,
      team_id: ENV["APPLE_TEAM_ID"]
    )

    # Write the API key to disk so xcodebuild can use it for provisioning updates.
    key_file = File.expand_path("asc_api_key.p8")
    File.write(key_file, ENV["ASC_API_KEY_P8"])

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{key_file} " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["APPLE_TEAM_ID"]
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.shakegasm.app",
      skip_waiting_for_build_processing: true
    )
  end
end
